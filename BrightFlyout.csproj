<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BrightFlyout</RootNamespace>
    <AssemblyName>BrightFlyout</AssemblyName>
    <Version>2.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged by default; pass -p:BuildMSIX=true for a packaged (MSIX) build. -->
    <WindowsPackageType Condition="'$(BuildMSIX)' != 'true'">None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- English-only by design (no .resw, all UI strings are literals), so no
         satellite assemblies. InvariantGlobalization is NOT an option: the XAML
         framework resolves the host culture when a window is first shown and
         throws CultureNotFoundException under invariant mode. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CsWin32 runs as a build task so its COM output can use the COM source
         generators ([GeneratedComInterface]) - required for NativeAOT.
         CsWin32PlatformTarget: NOTIFYICONDATAW & co. are arch-specific structs. -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <!-- DisableRuntimeMarshalling is declared in Native\AssemblyInfo.cs instead of via
         the MSBuild property so CsWin32's build-task generation pass sees it too. -->
  </PropertyGroup>

  <!-- MSIX packaging: framework-dependent Windows App SDK (the Microsoft.WindowsAppRuntime.2
       package dependency is injected automatically and pulled from the Store at install). -->
  <PropertyGroup Condition="'$(BuildMSIX)' == 'true'">
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageDir>AppPackages\</AppxPackageDir>
    <!-- Local convenience: sign with the dev cert if present (CI passes this explicitly). -->
    <PackageCertificateKeyFile Condition="'$(PackageCertificateKeyFile)' == '' and Exists('certs\BrightFlyout.pfx')">certs\BrightFlyout.pfx</PackageCertificateKeyFile>
  </PropertyGroup>

  <!-- Packaged apps resolve WASDK via the framework package, so the bootstrapper
       and background-task host DLLs are dead weight inside the MSIX. PDBs are
       excluded too: symbols are not shipped (their presence in the payload also
       triggers an mspdbcmf.exe warning without the VC++ build tools installed). -->
  <Target Name="RemovePackagedOnlyDeadWeight" BeforeTargets="_ComputeAppxPackagePayload" Condition="'$(BuildMSIX)' == 'true'">
    <ItemGroup>
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.FileName)' == 'Microsoft.WindowsAppRuntime.Bootstrap'" />
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.FileName)' == 'Microsoft.Windows.ApplicationModel.Background.UniversalBGTask'" />
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.Name)' == 'BrightFlyout.deps.json' and '$(PublishAot)' == 'true'" />
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.Name)' == 'BrightFlyout.runtimeconfig.json' and '$(PublishAot)' == 'true'" />
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.Extension)' == '.pdb'" />
      <!-- NOTE: the WASDK *managed* projection assemblies (Microsoft.WinUI.dll,
           Microsoft.Windows.SDK.NET.dll, ...) must ship in the package even for
           framework-dependent builds - MSIX framework packages only share native
           code; the CLR never probes them for managed assemblies. Removing them
           crashes the app at startup (verified). -->
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="BrightFlyout.app.ico" />
  </ItemGroup>

  <!-- Pinned for reproducible CI builds. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!-- Transitive Windows AI/ML payloads (onnxruntime, DirectML, AI winmds) are
         unused by this app; excluding them saves ~40 MB per package. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" />
    <!-- More unused transitive payloads: WebView2 (~1.1 MB) and the
         Search/Widgets component packages. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.6.5" ExcludeAssets="all" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.TextWriter" Version="3.0.0" />
    <!-- WMI (internal laptop panels) via WmiLight, which is NativeAOT-compatible
         (unlike System.Management, which needs built-in COM interop). WmiLight is
         linked statically into AOT builds so the package stays a single exe. -->
    <PackageReference Include="WmiLight" Version="7.3.0" />
  </ItemGroup>

  <!-- NativeAOT size tuning: optimize for size, fold identical method bodies,
       drop debugger support. Deliberately NOT set: UseSystemResourceKeys and
       StackTraceSupport=false (would ruin the exception messages/stack traces
       in debug.log) and EventSourceSupport (keep diagnostics channels). -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <DebuggerSupport>false</DebuggerSupport>
    <PublishWmiLightStaticallyLinked>true</PublishWmiLightStaticallyLinked>
  </PropertyGroup>

</Project>
