<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BrightFlyout.Views.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="Panel"
            Padding="20,0"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="8">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    x:Name="BrightnessIcon"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Glyph="&#xE706;" />

                <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                    <Border
                        x:Name="TrackBar"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="2" />
                    <Border
                        x:Name="FillBar"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="2"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="FillScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <TextBlock
                    x:Name="PercentText"
                    Grid.Column="2"
                    Width="38"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=""
                    TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
