<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BrightFlyout.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BrightFlyout Settings">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0" VerticalAlignment="Stretch">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Text="BrightFlyout Settings" />
            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16">
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center">

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Settings" />

                <!-- Displays -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Displays" />
                            <Button
                                x:Name="RefreshDisplaysButton"
                                Grid.Column="1"
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRefreshDisplaysClick"
                                ToolTipService.ToolTip="Refresh display list">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                        <!-- Rows (DisplaySettingsRow) are added to Items in code; see DisplayRowControl. -->
                        <ItemsControl x:Name="DisplayStatusItems" />
                        <TextBlock
                            x:Name="NoDisplaysText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No controllable displays found."
                            Visibility="Collapsed" />
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Brightness (keyboard target)" />
                            <Slider
                                x:Name="BrightnessSlider"
                                Maximum="100"
                                Minimum="0"
                                StepFrequency="1"
                                ValueChanged="OnBrightnessSliderChanged" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="MultiMonitorToggle"
                            Header="Control all displays (expandable flyout)"
                            OffContent=""
                            OnContent=""
                            Toggled="OnMultiMonitorToggled" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="When enabled, the flyout gets an expand arrow with one slider per display and a synchronize button. Keyboard keys control the display whose slider you touched last."
                            TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Default display (keyboard target at startup)" />
                            <ComboBox
                                x:Name="DefaultMonitorComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnDefaultMonitorChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Behavior" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Brightness step (%)" />
                            <NumberBox
                                x:Name="StepNumberBox"
                                Maximum="50"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnStepChanged" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="OSD visible time (seconds)" />
                            <NumberBox
                                x:Name="DurationNumberBox"
                                Maximum="10"
                                Minimum="0.5"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnDurationChanged" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Header="Run at Windows startup"
                            OffContent=""
                            OnContent=""
                            Toggled="OnStartupToggled" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Flyout appearance" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="Use system setting" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Show flyout on" />
                            <ComboBox
                                x:Name="PlacementComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnPlacementChanged">
                                <ComboBoxItem Content="Primary display" />
                                <ComboBoxItem Content="All displays" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Background" />
                            <ComboBox
                                x:Name="BackgroundComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnBackgroundStyleChanged">
                                <ComboBoxItem Content="Acrylic (system)" />
                                <ComboBoxItem Content="Custom color" />
                            </ComboBox>
                            <ColorPicker
                                x:Name="BackgroundColorPicker"
                                Margin="0,8,0,0"
                                IsAlphaEnabled="True"
                                IsMoreButtonVisible="True"
                                Visibility="Collapsed"
                                ColorChanged="OnBackgroundColorChanged" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Bar fill" />
                            <ComboBox
                                x:Name="FillComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnFillStyleChanged">
                                <ComboBoxItem Content="System accent color" />
                                <ComboBoxItem Content="Custom color" />
                            </ComboBox>
                            <ColorPicker
                                x:Name="FillColorPicker"
                                Margin="0,8,0,0"
                                IsMoreButtonVisible="True"
                                Visibility="Collapsed"
                                ColorChanged="OnFillColorChanged" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="PercentToggle"
                            Header="Show percentage on the flyout"
                            OffContent=""
                            OnContent=""
                            Toggled="OnPercentToggled" />

                        <ToggleSwitch
                            x:Name="ClickableBarToggle"
                            Header="Flyout bar responds to clicks"
                            OffContent=""
                            OnContent=""
                            Toggled="OnClickableBarToggled" />

                        <Button
                            x:Name="PreviewButton"
                            HorizontalAlignment="Left"
                            Click="OnPreviewClick"
                            Content="Preview flyout" />
                    </StackPanel>
                </Border>

                <!-- Input -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Keyboard input" />

                        <ToggleSwitch
                            x:Name="RawInputToggle"
                            Header="Listen for HID consumer brightness keys via Raw Input"
                            OffContent=""
                            OnContent=""
                            Toggled="OnRawInputToggled" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="Recommended. Keyboards that report brightness as HID consumer-control usages are invisible to keyboard hooks; Raw Input is how those keys are detected."
                            TextWrapping="Wrap" />

                        <TextBlock Text="Low-level hook (WH_KEYBOARD_LL) virtual key codes:" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Brightness down VK (hex)" />
                                <TextBox
                                    x:Name="VkDownTextBox"
                                    PlaceholderText="0x9E"
                                    TextChanged="OnVkTextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Brightness up VK (hex)" />
                                <TextBox
                                    x:Name="VkUpTextBox"
                                    PlaceholderText="0x9F"
                                    TextChanged="OnVkTextChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="Only needed if your keyboard emits actual virtual key codes for brightness. Matching key presses are swallowed before the shell sees them."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind VersionText}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
