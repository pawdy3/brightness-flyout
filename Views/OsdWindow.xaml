<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BrightFlyout.Views.OsdWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerEntered="OnRootPointerEntered"
        PointerExited="OnRootPointerExited">

        <Border
            x:Name="Panel"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Collapsed row: target display. Pointer handlers live on the row
                     so the whole pill is the click target; the expand button marks
                     its own presses handled and does not reach these. -->
                <Grid
                    Padding="20,0,8,0"
                    Background="Transparent"
                    ColumnSpacing="16"
                    PointerMoved="OnCollapsedRowPointerMoved"
                    PointerPressed="OnCollapsedRowPointerPressed"
                    PointerReleased="OnCollapsedRowPointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        x:Name="BrightnessIcon"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="20"
                        Glyph="&#xE706;" />

                    <Grid
                        x:Name="TrackArea"
                        Grid.Column="1"
                        Height="4"
                        VerticalAlignment="Center">
                        <Border
                            x:Name="TrackBar"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="2" />
                        <Border
                            x:Name="FillBar"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="2"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="FillScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <TextBlock
                        x:Name="PercentText"
                        Grid.Column="2"
                        Width="38"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text=""
                        TextAlignment="Right" />

                    <Button
                        x:Name="ExpandButton"
                        Grid.Column="3"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnExpandButtonClick"
                        Visibility="Collapsed">
                        <FontIcon
                            x:Name="ExpandIcon"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Button>
                </Grid>

                <!-- Expanded: one slider per display + synchronize -->
                <StackPanel
                    x:Name="ExpandedPanel"
                    Grid.Row="1"
                    Padding="20,0,20,10"
                    Spacing="4"
                    Visibility="Collapsed">

                    <!-- Rows (DisplayRowControl) are added to Items in code; see DisplayRowControl. -->
                    <ItemsControl x:Name="DisplayItems" />

                    <Grid Margin="0,8,0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="Synchronize all displays"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="SyncToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="OnSyncToggled" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
